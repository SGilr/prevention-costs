---
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import ResultPill from '../../components/ResultPill.astro';
import Grade from '../../components/Grade.astro';
import { ROWS, LEDGER, stageName, entryHref, byId } from '../../lib/ledger';
const pocket = LEDGER.pocket.map((p) => ({ p, r: byId(p.id)! }));
const both = ROWS.filter((r) => r.kind === 'Intervention' && r.payer && r.beneficiary);
const without = ROWS.filter((r) => r.kind === 'Intervention' && !(r.payer && r.beneficiary));
---
<Base title="Who pays and who benefits" description="Which budget pays for each preventive intervention in the ledger, and which systems receive the saving.">
  <div class="pagehead">
    <p class="eyebrow">Prevention Returns Ledger</p>
    <h1>Who Pays and Who Benefits</h1>
    <p class="lede">The reason sound prevention stays underfunded: the budget that pays rarely receives the saving.</p>
  </div>
  <section aria-labelledby="h-cases">
    <div class="sechead"><h2 id="h-cases">Cases where the payer and the beneficiary differ</h2></div>
    <ul class="pocket">
      {pocket.map(({ p, r }) => (
        <li>
          <h3>{r.short || r.item}</h3>
          <Flow row={r} />
          <p>{p.text}</p>
          <a href={entryHref(r.id)}>Open {r.id}</a>
        </li>
      ))}
    </ul>
  </section>
  <section aria-labelledby="h-all">
    <div class="sechead">
      <h2 id="h-all">Every intervention with a payer and a beneficiary</h2>
      <p>{both.length} of {ROWS.filter((r) => r.kind === 'Intervention').length} interventions name both. Payer and beneficiary are as recorded in the ledger.</p>
    </div>
    <div class="table-scroll" tabindex="0" role="region" aria-labelledby="h-all">
      <table class="data">
        <thead><tr><th scope="col">Entry</th><th scope="col">Stage</th><th scope="col">Pays</th><th scope="col">Benefits</th><th scope="col">Result</th><th scope="col">Grade</th></tr></thead>
        <tbody>
          {both.map((r) => (
            <tr>
              <th scope="row"><a href={entryHref(r.id)}>{r.id} {r.short || r.item}</a></th>
              <td>{stageName[r.stage]}</td>
              <td>{r.payer}</td>
              <td>{r.beneficiary}</td>
              <td><ResultPill row={r} /></td>
              <td><Grade grade={r.grade} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {without.length > 0 && (
      <p class="muted">No beneficiary is recorded for {without.map((r, i) => <>{i > 0 && ', '}<a href={entryHref(r.id)}>{r.id}</a></>)}.</p>
    )}
  </section>
</Base>
